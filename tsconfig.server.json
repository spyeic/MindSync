{
  "extends": "./tsconfig.json",
  "compilerOptions": {
    "module": "NodeNext",
    "moduleResolution": "NodeNext",
    "lib": ["ES2023"],
    "incremental": false,
    "noEmit": false,
    "rootDir": ".",
    "outDir": "dist",
    "rewriteRelativeImportExtensions": true
  },
  "include": ["server.ts", "server/**/*.ts"]
}
