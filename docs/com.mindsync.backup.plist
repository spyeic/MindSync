<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "https://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
  <key>Label</key><string>com.mindsync.backup</string>
  <key>ProgramArguments</key>
  <array>
    <string>/opt/homebrew/bin/node</string>
    <string>/Users/YOUR_USER/Projects/MindSync/scripts/backup.mjs</string>
  </array>
  <key>WorkingDirectory</key><string>/Users/YOUR_USER/Projects/MindSync</string>
  <key>EnvironmentVariables</key>
  <dict>
    <key>DATABASE_PATH</key><string>/Users/YOUR_USER/Library/Application Support/MindSync/data/mindsync.db</string>
    <key>BACKUP_DIR</key><string>/Users/YOUR_USER/Library/Application Support/MindSync/backups</string>
    <key>BACKUP_KEEP</key><string>14</string>
  </dict>
  <key>StartCalendarInterval</key><dict><key>Hour</key><integer>3</integer><key>Minute</key><integer>15</integer></dict>
  <key>StandardOutPath</key><string>/Users/YOUR_USER/Library/Logs/MindSync/backup.log</string>
  <key>StandardErrorPath</key><string>/Users/YOUR_USER/Library/Logs/MindSync/backup-error.log</string>
</dict>
</plist>
