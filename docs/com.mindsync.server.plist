<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "https://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
  <key>Label</key><string>com.mindsync.server</string>
  <key>ProgramArguments</key>
  <array>
    <string>/opt/homebrew/bin/node</string>
    <string>/Users/YOUR_USER/Projects/MindSync/dist/server.js</string>
  </array>
  <key>WorkingDirectory</key><string>/Users/YOUR_USER/Projects/MindSync</string>
  <key>EnvironmentVariables</key>
  <dict>
    <key>NODE_ENV</key><string>production</string>
    <key>HOST</key><string>127.0.0.1</string>
    <key>PORT</key><string>3000</string>
    <key>DATABASE_PATH</key><string>/Users/YOUR_USER/Library/Application Support/MindSync/data/mindsync.db</string>
    <key>PUBLIC_BASE_URL</key><string>https://play.example.com</string>
    <key>TRUST_PROXY</key><string>false</string>
  </dict>
  <key>RunAtLoad</key><true/>
  <key>KeepAlive</key><true/>
  <key>ThrottleInterval</key><integer>30</integer>
  <key>ExitTimeOut</key><integer>12</integer>
  <key>StandardOutPath</key><string>/Users/YOUR_USER/Library/Logs/MindSync/server.log</string>
  <key>StandardErrorPath</key><string>/Users/YOUR_USER/Library/Logs/MindSync/server-error.log</string>
</dict>
</plist>
